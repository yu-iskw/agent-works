{
  "name": "typescript-template",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "Apache-2.0",
  "author": "",
  "scripts": {
    "build": "pnpm --recursive build",
    "dev:up": "pnpm build && node scripts/dev-stack.mjs up",
    "dev:down": "node scripts/dev-stack.mjs down",
    "dev:reset": "pnpm build && node scripts/dev-stack.mjs reset",
    "trunk": "trunk",
    "format": "pnpm format:trunk",
    "format:all": "pnpm format:trunk-all",
    "format:eslint": "eslint . --fix",
    "format:prettier": "prettier --write .",
    "format:trunk": "trunk fmt",
    "format:trunk-all": "trunk fmt --all",
    "lint": "pnpm lint:trunk",
    "lint:all": "pnpm lint:trunk-all && pnpm security:grype",
    "lint:eslint": "eslint .",
    "lint:security": "trunk check --all --scope security",
    "lint:trunk": "trunk check -y",
    "lint:trunk-all": "trunk check --all -y",
    "security:grype": "grype .",
    "knip": "knip",
    "codeql:local": "bash dev/codeql.sh",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:watch": "vitest --coverage",
    "api:generate": "pnpm --filter @agent-works/domain build && pnpm --filter @agent-works/api-contract generate",
    "prebuild": "pnpm --filter @agent-works/domain build && pnpm --filter @agent-works/api-contract build",
    "pretest": "pnpm --filter @agent-works/domain build && pnpm --filter @agent-works/api-contract build",
    "typecheck": "pnpm --recursive exec tsc --noEmit",
    "p0:up": "docker compose -f compose.p0.yaml up --build -d --wait --wait-timeout 600 --force-recreate builder fake-directory api web fake-iap",
    "p0:down": "docker compose -f compose.p0.yaml down",
    "p0:e2e": "node scripts/p0-e2e.mjs all",
    "m1:doctor": "node scripts/m1/run.mjs doctor",
    "m1:up": "node scripts/m1/run.mjs up",
    "m1:up:local": "node scripts/m1/run.mjs up",
    "m1:down": "node scripts/m1/run.mjs down",
    "m1:reset": "node scripts/m1/run.mjs reset",
    "m1:test": "node scripts/m1/run.mjs test",
    "m1:e2e": "node scripts/m1/run.mjs e2e local && node scripts/m1/run.mjs e2e live",
    "m1:e2e:local": "node scripts/m1/run.mjs e2e local",
    "m1:e2e:live": "node scripts/m1/run.mjs e2e live",
    "m1:ux": "node scripts/m1/run.mjs ux",
    "m1:restart": "node scripts/m1/run.mjs restart",
    "m1:evidence": "node scripts/m1/run.mjs evidence",
    "m1:verify": "node scripts/m1/run.mjs verify"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@trunkio/launcher": "^1.3.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "knip": "^6.39.0",
    "postgres": "3.4.9",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@11.0.5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.5"
  }
}
