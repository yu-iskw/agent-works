{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "ignoreIssues": {
    "infra/terraform/evidence.mjs": ["binaries"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "stylelint.config.mjs",
        "scripts/adc-probe.mjs",
        "e2e/p0/playwright.config.ts",
        "tools/finops/*.mjs",
        "tools/slo/*.mjs",
        "tools/restore-drill/*.mjs",
        "e2e/m1/playwright.config.ts",
        "scripts/m1/*.mjs",
        "e2e/ui/playwright.config.ts",
        "scripts/ui/*.mjs"
      ],
      "project": [
        "**/*.{js,cjs,mjs,ts,cts,mts}",
        "!packages/**",
        "!apps/**",
        "!.trunk/**",
        "!node_modules/**",
        "!artifacts/**"
      ]
    },
    "apps/api": {
      "entry": [
        "src/server.ts",
        "src/workbench/vertex-smoke.ts",
        "src/reliability/dlq-service.ts",
        "src/reliability/postgres-dlq.ts",
        "src/reliability/retry-budget.ts",
        "src/reliability/degradation.ts",
        "src/reliability/drill-database.ts",
        "src/finops/budget-guard.ts",
        "src/finops/memory-budget.ts",
        "src/finops/postgres-budget.ts",
        "src/finops/showback.ts",
        "src/finops/model.ts",
        "src/finops/migration.ts",
        "src/finops/provider-usage.ts",
        "src/audit/siem-export/export.ts",
        "src/audit/siem-export/file-sink.ts",
        "src/audit/siem-export/memory-sink.ts",
        "src/audit/siem-export/reconcile.ts",
        "src/telemetry/events.ts",
        "src/telemetry/slo.ts",
        "src/teamwork/server.ts",
        "src/teamwork/smoke.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/server.ts", "src/m1-server.ts", "client/m1.ts", "client/workspace/main.tsx"],
      "project": [
        "src/**/*.ts",
        "app/**/*.ts",
        "app/**/*.tsx",
        "shared/**/*.ts",
        "client/**/*.ts",
        "client/**/*.tsx"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "entry": ["src/bench.ts", "src/schema-cli.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/api-contract": {
      "entry": ["scripts/*.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    }
  }
}
