{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "ignoreIssues": {
    "infra/terraform/evidence.mjs": ["binaries"]
  },
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs", "agents/skills/incident-analysis/eval-run.ts"],
      "project": [
        "**/*.{js,cjs,mjs,ts,cts,mts}",
        "!packages/**",
        "!apps/**",
        "!.trunk/**",
        "!node_modules/**"
      ]
    },
    "apps/api": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts", "app/**/*.ts", "app/**/*.tsx"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "entry": ["src/bench.ts", "src/schema-cli.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
