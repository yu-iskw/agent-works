{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs"],
      "project": ["**/*.{js,cjs,mjs,ts,cts,mts}", "!packages/**", "!.trunk/**", "!node_modules/**"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "entry": ["src/bench.ts", "src/schema-cli.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
