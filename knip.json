{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs"],
      "project": [
        "**/*.{js,cjs,mjs,ts,cts,mts}",
        "!packages/**",
        "!apps/**",
        "!.trunk/**",
        "!node_modules/**"
      ]
    },
    "apps/*": {
      "entry": ["src/server.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "packages/domain": {
      "entry": ["src/bench.ts", "src/schema-cli.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
