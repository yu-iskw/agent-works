# Copy to .env (git-ignored) before `docker compose up`. Holds no secrets: the
# containers authenticate with the Application Default Credentials (ADC) created by
# `gcloud auth application-default login` on your machine. Never put keys in this file.

# Google Cloud project the containers call (required). Use your dev project id.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Run containers as your host user so the bind mounts stay owned by you and the
# 0600 ADC file is readable on Linux. Set from `id -u` and `id -g`
# (macOS typically 501/20). Harmless on Docker Desktop.
HOST_UID=1000
HOST_GID=1000

# Host gcloud config directory, mounted read-only at /gcloud in containers that call
# Google Cloud. Default: ${HOME}/.config/gcloud
# GCLOUD_CONFIG_DIR=/path/to/gcloud

# Optional keyless identity for the gcp-probe: impersonate this service account.
# Needs roles/iam.serviceAccountTokenCreator on it for the ADC user.
# AW_IMPERSONATE_SERVICE_ACCOUNT=aw-api@your-gcp-project-id.iam.gserviceaccount.com

# Host port overrides (all bound to 127.0.0.1). Defaults shown.
# AW_IAP_PORT=8081
# AW_DRIVE_PORT=8082
# AW_LLM_PORT=8083
# AW_API_PORT=8084
# AW_WEB_PORT=8085
# AW_DIRECTORY_PORT=8086
# AW_WORKSPACE_PORT=8087
# AW_PROBE_PORT=8090
# AW_OTEL_PORT=4318
