{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "@agent-works/domain": ["../../packages/domain/src/index.ts"],
      "@agent-works/fakes": ["../../packages/fakes/src/index.ts"]
    }
  },
  "include": ["src"]
}
