project_id = "PROJECT_ID"
project_number = "PROJECT_NUMBER"
# Adopted-project switches (both default off).
enable_audit_config = false  # allServices audit logs in this root
enable_budget       = false  # alerts-only budget; needs billing_account_id and the bootstrap billing grant
# billing_account_id = "BILLING_ACCOUNT_ID"  # only when enable_budget = true
state_bucket = "PROJECT_ID-tfstate"
terraform_service_account = "aw-tf-dev@PROJECT_ID.iam.gserviceaccount.com"
# Supply reviewed digest-pinned images after foundations and manual secret versions.
images = {}
