project_id = "PROJECT_ID"
project_number = "PROJECT_NUMBER"
# Adopted-project switches (both default off).
enable_audit_config = false  # allServices audit logs in this root
enable_budget       = false  # alerts-only budget; needs billing_account_id and the bootstrap billing grant
# billing_account_id = "BILLING_ACCOUNT_ID"  # only when enable_budget = true
state_bucket = "PROJECT_ID-tfstate"
terraform_service_account = "aw-tf-dev@PROJECT_ID.iam.gserviceaccount.com"
# Supply reviewed digest-pinned images after foundations and manual secret versions.
images = {}
# aw-api calls Vertex AI on the global endpoint with gemini-4-hydrogen. ADR-0008
# (docs/adr/0008-vertex-ai-region-and-model.md) is the recorded residency exception for model
# calls only; Cloud Run, Cloud SQL, IAP and every other resource here stay in asia-northeast1.
# Merge these keys into the rest of aw-api's env (DATABASE_URL, IAP_*, ...); deploy-dev.yml
# refuses an aw-api without AW_MODE = "production".
# service_env = {
#   api = {
#     AW_MODE               = "production"
#     GOOGLE_CLOUD_PROJECT  = "PROJECT_ID"
#     GOOGLE_CLOUD_LOCATION = "global"
#     VERTEX_MODEL_ID       = "gemini-4-hydrogen"
#     LLM_MODE              = "vertex"
#   }
# }
