{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "submit"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "skillId": {
          "type": "string",
          "minLength": 1
        },
        "sourceAllowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requestedOutputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "executionPolicy": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "minLength": 1
            },
            "budgetUsd": {
              "type": "number",
              "minimum": 0
            },
            "deadlineSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["mode", "budgetUsd", "deadlineSeconds"],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "objective",
        "skillId",
        "sourceAllowlist",
        "requestedOutputs",
        "executionPolicy"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "accepted"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "AUTHORIZED",
            "QUEUED",
            "RUNNING",
            "COMPLETED",
            "WAITING_APPROVAL",
            "WAITING_INPUT",
            "BLOCKED_AUTH",
            "PAUSED",
            "RETRYING",
            "FAILED",
            "CANCELLED"
          ]
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "statusUrl": {
          "type": "string",
          "minLength": 1
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "taskId", "status", "submittedAt", "statusUrl", "traceId"],
      "additionalProperties": false
    }
  ]
}
