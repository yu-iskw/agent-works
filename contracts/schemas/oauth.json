{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "start"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "codeChallenge": {
          "type": "string",
          "minLength": 1
        },
        "codeChallengeMethod": {
          "type": "string",
          "const": "S256"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "provider", "state", "codeChallenge", "codeChallengeMethod", "scope"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "callback"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "codeVerifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "provider", "state", "code", "codeVerifier"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "connection"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["active", "revoked", "expired"]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "tokenRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "provider", "subject", "scope", "status", "expiresAt", "tokenRef"],
      "additionalProperties": false
    }
  ]
}
