{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "detail"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "actionSummary": {
          "type": "string",
          "minLength": 1
        },
        "requestedBySub": {
          "type": "string",
          "minLength": 1
        },
        "payloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "kind",
        "id",
        "actionSummary",
        "requestedBySub",
        "payloadSha256",
        "state",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "decide"
        },
        "decision": {
          "type": "string",
          "enum": ["approve", "reject"]
        },
        "expectedPayloadSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["kind", "decision", "expectedPayloadSha256"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "decided"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": ["approved", "rejected"]
        },
        "executionsUsed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["kind", "id", "state", "executionsUsed"],
      "additionalProperties": false
    }
  ]
}
