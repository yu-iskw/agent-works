{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "internal.agents/v1"
    },
    "kind": {
      "type": "string",
      "const": "ToolDefinition"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name", "version", "owner"],
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "inputSchemaRef": {
          "type": "string",
          "minLength": 1
        },
        "sideEffect": {
          "type": "string",
          "enum": ["READ", "WRITE_LOW", "EXTERNAL_SEND", "WRITE_HIGH", "ADMIN", "CODE_EXEC"]
        },
        "dataClassificationMax": {
          "type": "string",
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "DRAFT",
            "SECURITY_REVIEW",
            "EVALUATED",
            "APPROVED",
            "PUBLISHED",
            "DEPRECATED",
            "REVOKED"
          ]
        },
        "permissions": {
          "type": "object",
          "properties": {
            "workloadCapability": {
              "type": "string",
              "minLength": 1
            },
            "userAuthority": {
              "type": "string",
              "enum": ["delegated", "approvedService"]
            },
            "resourceConstraint": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["workloadCapability", "userAuthority", "resourceConstraint"],
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean"
            },
            "policy": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["required", "policy"],
          "additionalProperties": false
        },
        "execution": {
          "type": "object",
          "properties": {
            "timeoutSeconds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "idempotency": {
              "type": "string",
              "const": "required"
            }
          },
          "required": ["timeoutSeconds", "retries", "idempotency"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "properties": {
            "logRequestDigest": {
              "type": "boolean"
            },
            "logExternalObjectId": {
              "type": "boolean"
            },
            "redactFields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": ["logRequestDigest", "logExternalObjectId", "redactFields"],
          "additionalProperties": false
        }
      },
      "required": [
        "description",
        "executor",
        "inputSchemaRef",
        "sideEffect",
        "dataClassificationMax",
        "lifecycle",
        "permissions",
        "approval",
        "execution",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false
}
