# Example of ~/.config/agent-works-m1/m1.env (no real values). Copy it there, chmod 600, fill in.
# The stack mounts the directory read-only into web, api-alpha and api-beta. Never commit the real file.

# Google OAuth web client (docs/m1/SETUP_OAUTH.md section 1)
AW_M1_GOOGLE_CLIENT_ID=
AW_M1_GOOGLE_CLIENT_SECRET=
# GitHub OAuth App, no scopes (section 2)
AW_M1_GITHUB_CLIENT_ID=
AW_M1_GITHUB_CLIENT_SECRET=

# Segment membership: Google account emails, comma separated
AW_M1_ALPHA_MEMBERS=
AW_M1_BETA_MEMBERS=
# Optional: members whose entitlement excludes publishing (docs.publish)
AW_M1_ALPHA_READONLY_MEMBERS=
AW_M1_BETA_READONLY_MEMBERS=

# End-to-end session runner (section 4); at least 32 characters, for example `openssl rand -hex 32`
AW_M1_E2E_SESSION_SECRET=

# Live test resources (docs/m1/SETUP_RESOURCES.md section 4)
AW_M1_ALPHA_DRIVE_RESEARCH_FOLDER=
AW_M1_ALPHA_DRIVE_CONTEXT_FOLDER=
AW_M1_BETA_DRIVE_RESEARCH_FOLDER=
AW_M1_BETA_DRIVE_CONTEXT_FOLDER=
AW_M1_RESTRICTED_DRIVE_FOLDER=
AW_M1_BIGQUERY_PROJECT=ubie-yu-sandbox
AW_M1_ALPHA_BIGQUERY_DATASET=aw_m1_alpha
AW_M1_BETA_BIGQUERY_DATASET=aw_m1_beta
AW_M1_GITHUB_REPOSITORY=yu-iskw/agent-works
AW_M1_GITHUB_PINNED_REF=f96cac7243fdbdd6a1f419214aabf17e61e65b8f
AW_M1_ALPHA_GITHUB_ISSUE=
AW_M1_BETA_GITHUB_ISSUE=
