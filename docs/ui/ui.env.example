# UI milestone stack: optional host overrides for `pnpm ui:*` (scripts/ui/run.mjs).
# Nothing here is a secret and nothing is required. The commands set identity, sources, campaign,
# cap and concurrency themselves; values exported in the shell for those are refused or ignored.
# Example use: `set -a; source docs/ui/ui.env.example; set +a; pnpm ui:doctor`.

# Directory holding application_default_credentials.json, bind-mounted read-only into api-alpha and
# api-beta only. Create it with `gcloud auth application-default login`. Default: ~/.config/gcloud.
GCLOUD_CONFIG_DIR=

# Google Cloud project that owns the Vertex AI quota. Default: ubie-yu-sandbox.
AW_M1_GOOGLE_CLOUD_PROJECT=

# Vertex location. gemini-3.8-flash is served from `global`; regional endpoints return model_not_found.
AW_M1_GOOGLE_CLOUD_LOCATION=global

# Requested model. Changing it is an operator decision; the doctor fails on any other id.
AW_M1_VERTEX_MODEL_ID=gemini-3.8-flash

# Output-token bound per model call. Default: 8192.
AW_M1_VERTEX_MAX_OUTPUT_TOKENS=

# Docker socket when it is not the default, for example Rancher Desktop on macOS.
DOCKER_HOST=

# Container user for the bind mounts. The scripts pass the current uid and gid automatically;
# export these only when running `docker compose` by hand.
HOST_UID=
HOST_GID=

# Fixed by the UI commands (listed for reference, not read from the shell):
#   AW_M1_LLM_MODE=vertex                     real model only; scripted or disabled is refused
#   AW_M1_MODEL_CAMPAIGN=ui-2026-10           ledger campaign the cap counts
#   AW_M1_MAX_MODEL_CALLS_PER_SEGMENT=300     per segment database, so 600 in total
#   AW_M1_CONCURRENCY=2                       worker concurrency per segment
#   AW_M1_IDENTITY=local-test                 mock members alice@local.test and bob@local.test
#   AW_M1_SOURCE_MODE=fixture                 repository fixture files as sources
#   AW_M1_FIXTURE_FAULTS=1                    fixture fault injection on
#   AW_M1_PORT=8281                           web, bound to 127.0.0.1
