{
  "name": "@agent-works/domain",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./budget": {
      "types": "./src/budget.ts",
      "development": "./src/budget.ts",
      "import": "./dist/budget.js"
    },
    "./error-class": {
      "types": "./src/error-class.ts",
      "development": "./src/error-class.ts",
      "import": "./dist/error-class.js"
    },
    "./error-class-retry": {
      "types": "./src/error-class-retry.ts",
      "development": "./src/error-class-retry.ts",
      "import": "./dist/error-class-retry.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "schemas": "tsc -p tsconfig.json && node dist/schema-cli.js",
    "bench": "tsc -p tsconfig.json && node dist/bench.js"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "fast-check": "4.10.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
